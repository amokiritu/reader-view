{
  "manifest_version": 3,
  "name": "Reader View",
  "version": "0.2.5",
  "description": "Read articles in a clean, distraction-free view with adjustable text size, fonts and themes.",
  "homepage_url": "https://github.com/amokiritu/reader-view",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Show Reader (Alt+Shift+R)",
    "default_icon": {
      "16": "icons/reader-16.png",
      "32": "icons/reader-32.png",
      "48": "icons/reader-48.png",
      "128": "icons/reader-128.png"
    }
  },
  "icons": {
    "16": "icons/reader-16.png",
    "32": "icons/reader-32.png",
    "48": "icons/reader-48.png",
    "128": "icons/reader-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Show or hide Reader"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "vendor/Readability-readerable.js",
        "src/detect.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
